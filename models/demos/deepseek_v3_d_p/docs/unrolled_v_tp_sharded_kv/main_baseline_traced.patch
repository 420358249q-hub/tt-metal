+# Scratch (untracked, baseline worktree only): main's ring_mla MLA forward timed as a traced replay, for comparison
+# with the unrolled-V branch's test_mla_chunked_tp_sharded_traced_perf.
+import pytest
+from loguru import logger
+
+from models.demos.deepseek_v3_d_p.tests.test_mla import _run_chunked_prefill, torus_xy_device_params
+from models.demos.deepseek_v3_d_p.tt.tt_ccl import per_axis_topology
+
+
+@pytest.mark.parametrize(
+    "mesh_device,device_params",
+    [
+        pytest.param(
+            (8, 4),
+            torus_xy_device_params(l1_small_size=1152, trace_region_size=64 * 1024 * 1024),
+            id="torus-xy-8x4",
+        )
+    ],
+    indirect=["mesh_device", "device_params"],
+)
+@pytest.mark.parametrize(
+    "variant,prefill_len",
+    [("kimi_k3", 50 * 1024), ("kimi_k3", 512 * 1024), ("kimi_k2_7", 50 * 1024), ("kimi_k2_7", 256 * 1024)],
+    ids=["k3-50k", "k3-512k", "k2_7-50k", "k2_7-256k"],
+    indirect=["variant"],
+)
+@pytest.mark.timeout(0)
+def test_main_traced_baseline(request, mesh_device, device_params, variant, prefill_len):
+    ns = _run_chunked_prefill(
+        request,
+        mesh_device,
+        reference=None,
+        topology=per_axis_topology(device_params["fabric_config"]),
+        iters_isl=[5120],
+        prefill_len=prefill_len,
+        use_metadata_tensor=True,
+        trace_time=True,
+    )
+    logger.info(f"RESULT main {variant.name} {prefill_len} + 5120 traced forward: {ns / 1e6:.3f} ms")
